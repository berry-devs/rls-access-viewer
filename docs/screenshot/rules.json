      "name": "is_banned",
      "definition": "CREATE OR REPLACE FUNCTION public.is_banned(uid uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  SELECT coalesce((SELECT banned FROM public.profiles WHERE id = uid), false)\n$function$\n"
