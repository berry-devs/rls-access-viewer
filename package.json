{
  "name": "@berry-devs/rls-access-viewer",
  "version": "0.1.0",
  "description": "Read-only viewer that renders the RLS policies, GRANTs, triggers and Storage policies of a Supabase database, in evaluation order, as a single HTML page",
  "keywords": [
    "supabase",
    "rls",
    "row-level-security",
    "postgres",
    "postgresql",
    "policy",
    "grant",
    "storage",
    "viewer",
    "security"
  ],
  "license": "MIT",
  "homepage": "https://github.com/berry-devs/rls-access-viewer#readme",
  "bugs": {
    "url": "https://github.com/berry-devs/rls-access-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berry-devs/rls-access-viewer.git"
  },
  "type": "module",
  "bin": {
    "rls-access-viewer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "schemas",
    "rls-access-viewer.config.json",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "cli": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
